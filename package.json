{
  "name": "project-agent-memory",
  "version": "3.4.2",
  "publishedVersion": "3.4.2",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "project-agent-memory": "dist/bin.js",
    "project-agent-memory-cli": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skill/",
    "stack/",
    "hooks/",
    "commands/",
    "vault/",
    "grammars/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "prepack": "node bin/fetch-grammars.cjs",
    "sync-published-version": "node bin/sync-published-version.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:gemini": "node tests/test-gemini-error-handling.js",
    "test:coverage": "c8 --reporter=text-summary --include=dist/** --include=src/** node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "mcp",
    "memory",
    "qdrant",
    "vector-database",
    "ai",
    "embeddings"
  ],
  "author": "Balaji.G",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/balaji-g42/project-agent-memory.git"
  },
  "homepage": "https://github.com/balaji-g42/project-agent-memory.git",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "axios": "^1.12.1",
    "dotenv": "^16.4.5",
    "openai": "^7.45.1",
    "uuid": "^11.0.5",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "c8": "^12.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2"
  },
  "description": "MCP server for memory management using vector database",
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  }
}
