# Storage backend: qdrant (default) or postgres
MEMORY_BACKEND=qdrant

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres/pgvector Configuration - used when MEMORY_BACKEND=postgres
POSTGRES_URL=postgresql://postgres@localhost:5432/memory
POSTGRES_PASSWORD=

# Connection pool size - applies to the selected backend
POOL_SIZE=10

# Vectors
# Changing VECTOR_DIM deletes and recreates existing collections
VECTOR_DIM=768
DISTANCE_METRIC=Cosine

# Embedding Configuration
# Options: onnx (default), openai, gemini, openrouter
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# onnx provider
ONNX_MODEL_CACHE_DIR=
ONNX_DTYPE=q8

# openai provider - any OpenAI-compatible /v1/embeddings endpoint
# Ollama: http://localhost:11434/v1 - LM Studio: http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Summarizer Configuration
# Options: openrouter (default), gemini, ollama
SUMMARIZER_PROVIDER=openrouter
SUMMARIZER_MODEL=openai/gpt-oss-20b:free

# Provider API Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Ollama Configuration - summarizer only
OLLAMA_API_URL=http://localhost:11434
OLLAMA_API_KEY=

# Caching
CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_SIZE=1000
QUERY_CACHE_SIZE=500
